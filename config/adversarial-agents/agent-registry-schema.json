{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jdylanmc/game-hub/config/adversarial-agents/agent-registry-schema.json",
  "title": "Independent Adversarial Agent Registry",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryVersion", "agents", "subscriptionId", "requirementsMet"],
  "properties": {
    "registryVersion": {
      "const": "1.0.0"
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "enabled",
          "promptFile",
          "promptVersion",
          "promptContentHash",
          "schemaFile",
          "schemaContentHash",
          "policyFile",
          "policyContentHash",
          "engineConfigFile",
          "engineConfigContentHash",
          "benchmarkCorpusFile",
          "benchmarkCorpusContentHash",
          "promotionPolicyFile",
          "promotionPolicyContentHash",
          "activeCalibrationReportFile",
          "checkName",
          "stateNamespace",
          "modelDeployment",
          "modelVersion",
          "toolsVersion",
          "description",
          "targetScopes",
          "contactEmail",
          "verdictRules",
          "executionConfig"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "version": {
            "$ref": "#/$defs/semanticVersion"
          },
          "enabled": {
            "type": "boolean"
          },
          "promptFile": {
            "$ref": "#/$defs/repositoryPath"
          },
          "promptVersion": {
            "$ref": "#/$defs/semanticVersion"
          },
          "promptContentHash": {
            "$ref": "#/$defs/sha256"
          },
          "schemaFile": {
            "$ref": "#/$defs/repositoryPath"
          },
          "schemaContentHash": {
            "$ref": "#/$defs/sha256"
          },
          "policyFile": {
            "$ref": "#/$defs/repositoryPath"
          },
          "policyContentHash": {
            "$ref": "#/$defs/sha256"
          },
          "engineConfigFile": {
            "$ref": "#/$defs/repositoryPath"
          },
          "engineConfigContentHash": {
            "$ref": "#/$defs/sha256"
          },
          "benchmarkCorpusFile": {
            "$ref": "#/$defs/repositoryPath"
          },
          "benchmarkCorpusContentHash": {
            "$ref": "#/$defs/sha256"
          },
          "promotionPolicyFile": {
            "$ref": "#/$defs/repositoryPath"
          },
          "promotionPolicyContentHash": {
            "$ref": "#/$defs/sha256"
          },
          "activeCalibrationReportFile": {
            "$ref": "#/$defs/repositoryPath"
          },
          "checkName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "stateNamespace": {
            "type": "string",
            "pattern": "^adversarial/[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "modelDeployment": {
            "type": "string",
            "minLength": 1
          },
          "modelVersion": {
            "type": "string",
            "minLength": 1
          },
          "toolsVersion": {
            "$ref": "#/$defs/semanticVersion"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "targetScopes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "contactEmail": {
            "type": "string",
            "format": "email"
          },
          "verdictRules": {
            "type": "object",
            "additionalProperties": false,
            "required": ["blockingThreshold", "allowHighConfidenceOnly"],
            "properties": {
              "blockingThreshold": {
                "type": "integer",
                "minimum": 1
              },
              "allowHighConfidenceOnly": {
                "const": true
              }
            }
          },
          "executionConfig": {
            "type": "object",
            "additionalProperties": false,
            "required": ["maxConcurrentReviews"],
            "properties": {
              "maxConcurrentReviews": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              }
            }
          }
        }
      }
    },
    "subscriptionId": {
      "const": "11213dbd-39fe-46ba-87db-5f5e8c449aed"
    },
    "requirementsMet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versionedJsonSchema",
        "dedicatedPromptFiles",
        "independentVersioning",
        "validationRequired",
        "agentRegistration"
      ],
      "properties": {
        "versionedJsonSchema": {
          "const": true
        },
        "dedicatedPromptFiles": {
          "const": true
        },
        "independentVersioning": {
          "const": true
        },
        "validationRequired": {
          "const": true
        },
        "agentRegistration": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
