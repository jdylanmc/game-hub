{
  "version": "1.0.2",
  "limits": {
    "maxPacketBytes": 2097152,
    "maxEvidenceBytes": 786432,
    "maxMetadataBytes": 32768,
    "maxFileBytes": 32768,
    "maxPatchBytes": 65536,
    "diffContextLines": 3
  },
  "productionRoots": ["src/", "games/", "packages/", "scripts/"],
  "testPatterns": ["**/*.test.ts", "**/*.test.tsx", "**/*.test.js", "**/*.test.mjs", "**/*.spec.ts", "**/*.spec.tsx"],
  "inertChangedEvidence": {
    "paths": ["docs/memories/56-shared-adversarial-reviewer-platform/shared-v2-source/**"],
    "limitation": "Dormant v2 source is metadata-only until explicit activation."
  },
  "sections": {
    "contracts": {
      "mandatory": true,
      "maxFiles": 20,
      "maxBytes": 65536,
      "patterns": ["packages/game-contract/**"]
    },
    "manifests": {
      "mandatory": true,
      "maxFiles": 40,
      "maxBytes": 65536,
      "patterns": [
        "package.json",
        "games/*/package.json",
        "packages/*/package.json",
        "public/generated/games.manifest.json"
      ]
    },
    "generators": {
      "mandatory": true,
      "maxFiles": 20,
      "maxBytes": 65536,
      "patterns": ["scripts/generate-*.mjs"]
    },
    "workflows": {
      "mandatory": true,
      "maxFiles": 20,
      "maxBytes": 65536,
      "patterns": [".github/workflows/*.yml", ".github/workflows/*.yaml"]
    },
    "validationConfig": {
      "mandatory": true,
      "maxFiles": 60,
      "maxBytes": 196608,
      "patterns": [
        "config/**",
        "package.json",
        "eslint.config.js",
        "tsconfig*.json",
        "vite.config.ts",
        "vitest.config.ts"
      ]
    },
    "relevantTests": {
      "mandatory": true,
      "maxFiles": 100,
      "maxBytes": 524288,
      "patterns": [
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "games/**/*.test.ts",
        "games/**/*.test.tsx",
        "packages/**/*.test.ts",
        "packages/**/*.test.tsx",
        "scripts/**/*.test.mjs"
      ]
    }
  }
}
