{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "deterministicWorkflowName": "Continuous integration",
  "deterministicWorkflowPath": ".github/workflows/continuous-integration.yml",
  "trustedBaseBranch": "main",
  "maxConcurrentReviews": 3,
  "maxChangedFiles": 500,
  "reviewTimeoutMinutes": 20,
  "artifactRetentionDays": 90,
  "relevantPaths": [
    ".github/workflows/**",
    "config/**",
    "games/**",
    "infra/**",
    "packages/**",
    "scripts/**",
    "src/**",
    "package.json",
    "yarn.lock",
    "eslint.config.js",
    "tsconfig*.json",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
