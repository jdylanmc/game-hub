{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jdylanmc/game-hub/config/adversarial-agents/exception-schema.json",
  "title": "Adversarial Finding Exception",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exceptionVersion",
    "exceptionId",
    "owner",
    "rationale",
    "issue",
    "createdAt",
    "expiresAt",
    "affected",
    "auditEvidence",
    "integritySha256"
  ],
  "properties": {
    "exceptionVersion": {
      "const": "1.0.0"
    },
    "exceptionId": {
      "type": "string",
      "pattern": "^EXC-[0-9]{8}-[A-Z0-9]{6,16}$"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["githubLogin"],
      "properties": {
        "githubLogin": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
        }
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1000
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "number", "url"],
      "properties": {
        "repository": {
          "const": "jdylanmc/game-hub"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/jdylanmc/game-hub/issues/[1-9][0-9]*$"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "affected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentName", "agentVersion", "repository", "headSha", "runFingerprint", "findingFingerprint"],
      "properties": {
        "agentName": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "agentVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "repository": {
          "const": "jdylanmc/game-hub"
        },
        "headSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "runFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "findingFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "auditEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedBy", "approvedAt", "approvalUrl", "approvalRecordSha256"],
      "properties": {
        "approvedBy": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "approvalUrl": {
          "type": "string",
          "pattern": "^https://github\\.com/jdylanmc/game-hub/issues/[1-9][0-9]*#issuecomment-[1-9][0-9]*$"
        },
        "approvalRecordSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "integritySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
