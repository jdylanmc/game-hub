{
  "version": "1.0.0",
  "schemaVersion": "1.0.0",
  "agentName": "gilfoyle-security-architect",
  "producerVersion": "1.0.0",
  "limits": {
    "maxManifestBytes": 131072,
    "maxFindingsPerCheck": 100,
    "maxEvidenceFilesPerCheck": 20,
    "maxEvidenceFileBytes": 10485760
  },
  "requiredChecks": [
    "codeql",
    "dependency-review",
    "dependency-audit",
    "secret-detection",
    "workflow-policy",
    "bicep-analysis",
    "container-scan"
  ],
  "checks": {
    "codeql": {
      "surfaces": ["application", "games", "scripts"],
      "applicability": "always",
      "enforcement": "BLOCKING",
      "tool": {
        "name": "github/codeql-action",
        "version": "3.37.6",
        "commitSha": "c4dd10e44af883a891fe31ced449bcb4a6728b9b"
      },
      "blockingPolicy": {
        "minimumSecuritySeverity": 7,
        "errorLevelBlocks": true
      }
    },
    "dependency-review": {
      "surfaces": ["dependencies"],
      "applicability": "pull-request",
      "enforcement": "BLOCKING",
      "tool": {
        "name": "actions/dependency-review-action",
        "version": "4.9.0",
        "commitSha": "2031cfc080254a8a887f58cffee85186f0e49e48"
      },
      "blockingPolicy": {
        "minimumSeverity": "high",
        "warnOnly": false
      }
    },
    "dependency-audit": {
      "surfaces": ["dependencies"],
      "applicability": "always",
      "enforcement": "BLOCKING",
      "tool": {
        "name": "yarn npm audit",
        "version": "4.17.1",
        "command": "yarn security:audit"
      },
      "blockingPolicy": {
        "minimumSeverity": "high"
      }
    },
    "secret-detection": {
      "surfaces": [
        "application",
        "games",
        "infrastructure",
        "workflows",
        "dependencies",
        "configuration",
        "contracts",
        "manifests"
      ],
      "applicability": "always",
      "enforcement": "BLOCKING",
      "tool": {
        "name": "game-hub-secret-diff-scanner",
        "version": "1.0.0",
        "command": "yarn security:secrets"
      },
      "blockingPolicy": {
        "highConfidenceMatchesBlock": true,
        "unscannableBinaryChangesBlock": true
      }
    },
    "workflow-policy": {
      "surfaces": ["workflows", "configuration"],
      "applicability": "always",
      "enforcement": "BLOCKING",
      "tool": {
        "name": "game-hub-workflow-policy",
        "version": "1.0.0",
        "command": "yarn policy:check"
      },
      "blockingPolicy": {
        "anyViolationBlocks": true
      }
    },
    "bicep-analysis": {
      "surfaces": ["infrastructure"],
      "applicability": "always",
      "enforcement": "BLOCKING",
      "tool": {
        "name": "Azure Bicep CLI",
        "version": "0.42.1",
        "command": "yarn security:bicep"
      },
      "blockingPolicy": {
        "compileOrParameterFailureBlocks": true
      }
    },
    "container-scan": {
      "surfaces": ["containers"],
      "applicability": "surface-present",
      "enforcement": "BLOCKING",
      "tool": {
        "name": "game-hub-container-surface-guard",
        "version": "1.0.0",
        "command": "yarn security:containers"
      },
      "blockingPolicy": {
        "absentSurfaceStatus": "NOT_APPLICABLE",
        "presentWithoutScannerStatus": "UNSUPPORTED",
        "unsupportedBlocks": true
      }
    }
  }
}
