{
  "name": "game-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "yarn@4.17.1",
  "engines": {
    "node": "24.13.0"
  },
  "workspaces": [
    "packages/*",
    "games/*"
  ],
  "scripts": {
    "install:check": "yarn install --immutable",
    "generate:games": "node scripts/generate-game-workspaces.mjs",
    "generate:check": "node scripts/check-generated-state.mjs",
    "dev": "yarn generate:games && vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:suppressions": "node scripts/check-lint-suppressions.mjs",
    "policy:workflow": "node scripts/check-workflow-policy.mjs",
    "policy:adversarial": "node scripts/check-adversarial-policy.mjs",
    "policy:check": "yarn lint:suppressions && yarn policy:workflow && yarn policy:adversarial-workflow && yarn policy:adversarial",
    "context:collect": "node scripts/collect-adversarial-context.ts",
    "review:adversarial": "node scripts/review-adversarial-context.ts",
    "publish:adversarial": "node scripts/publish-adversarial-evidence.ts",
    "exceptions:validate": "node scripts/apply-adversarial-exceptions.ts --exceptions config/adversarial-agents/exceptions.json",
    "agents:validate": "node scripts/validate-adversarial-agent-registry.ts .",
    "workflow:prepare-adversarial": "node scripts/prepare-adversarial-workflow.ts",
    "policy:adversarial-workflow": "node scripts/check-adversarial-workflow-policy.mjs",
    "calibrate:adversarial": "node scripts/evaluate-adversarial-reviewer.ts",
    "calibration:check": "node scripts/evaluate-adversarial-reviewer.ts --mode check",
    "security:audit": "yarn npm audit --all --recursive --severity high",
    "ralph:prioritize": "node scripts/find-failing-ralph-pr.mjs jdylanmc/game-hub",
    "test:ci-fail-closed": "node scripts/prove-ci-fail-closed.mjs",
    "test:integrity": "node scripts/check-test-integrity.mjs",
    "test": "yarn test:coverage",
    "test:coverage": "yarn test:integrity && vitest run --sequence.shuffle --sequence.seed=29005 --coverage --reporter=default --reporter=junit --outputFile.junit=test-results/junit.xml",
    "build": "yarn generate:games && tsc -b && vite build",
    "bundle:check": "node scripts/check-bundle-budgets.mjs",
    "build-storybook": "yarn generate:games && storybook build",
    "generate:mamba-storybook": "node scripts/generate-mamba-storybook.mjs",
    "preview": "vite preview",
    "storybook": "yarn generate:games && storybook dev -p 6006",
    "typecheck": "yarn generate:games && tsc -b",
    "validate": "yarn install:check && yarn format:check && yarn lint && yarn policy:check && yarn test:ci-fail-closed && yarn security:audit && yarn test:coverage && yarn generate:check && yarn typecheck && yarn build && yarn bundle:check && yarn build-storybook"
  },
  "dependencies": {
    "@game-hub/game-contract": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@azure/identity": "4.13.1",
    "@eslint/js": "9.39.5",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.5",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "^10.4.27",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "node-html-parser": "^9.0.1",
    "postcss": "^8.5.14",
    "prettier": "3.9.6",
    "storybook": "^10.5.7",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "^6.0.0 || ^7.0.0",
    "vitest": "4.1.10"
  }
}
